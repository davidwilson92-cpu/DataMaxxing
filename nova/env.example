# Core
DATABASE_URL=sqlite:///./nova.db
ADMIN_API_KEY=replace-with-long-random-secret
SESSION_SECRET=replace-with-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=generate-with-generate_fernet_key.py
PUBLIC_BASE_URL=https://x-chatgpt-poster.onrender.com
PRIVACY_CONTACT_EMAIL=privacy@yourdomain.com

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# X OAuth 2.0 (existing V3/V4 values can remain)
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
X_OAUTH2_REDIRECT_URI=https://x-chatgpt-poster.onrender.com/callback/x

# Meta / Facebook + Instagram
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_REDIRECT_URI=https://x-chatgpt-poster.onrender.com/oauth/meta/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://YOUR-DOMAIN/oauth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://x-chatgpt-poster.onrender.com/oauth/tiktok/callback
TIKTOK_DEFAULT_PRIVACY=PUBLIC_TO_EVERYONE

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
REQUIRE_SUBSCRIPTION=false
NOVA_PRICE_LABEL=Creator plan
NOVA_PRICE_NOTE=Cancel from your account at any time.

# Scheduler
SCHEDULER_SECRET=replace-with-long-random-secret
# Optional distinct read-only credential for /internal/status and /internal/ready.
# Never give a monitor SCHEDULER_SECRET or ADMIN_API_KEY.
MONITOR_READ_TOKEN=
SCHEDULER_INTERVAL_SECONDS=60
# Keep embedded on the existing single-instance beta. External requires the
# private-storage/database checks documented in docs/architecture/CLOUD_MIGRATION_20261019.md.
ZOVA_SCHEDULER_MODE=embedded
ZOVA_WEB_REPLICAS=1
ZOVA_SCHEMA_MODE=initialize
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Required only for external mode; set below the database's actual connection limit.
DB_CONNECTION_BUDGET=
# Explicit per-user permission before AI processing. Do not disable in production.
ZOVA_AI_CONSENT_REQUIRED=true

# Optional persistent image storage. Recommended for scheduled Meta/TikTok posts.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_ENDPOINT_URL=

# Legacy X Custom GPT compatibility. Keep your existing values if you use it.
BOOTSTRAP_CREATOR_API_KEY=
BOOTSTRAP_CREATOR_NAME=
X_USERNAME=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Direct Post only: must match a URL prefix verified in TikTok Developer Portal.
# Leave production inbox delivery enabled until Direct Post approval and validation.
TIKTOK_VERIFIED_MEDIA_PREFIX=
